// This app's tables live in Supabase Postgres. The SQL that actually creates
// them lives in supabase/sql/*.sql (run those in the Supabase SQL Editor) —
// this file is kept in sync by hand so the app gets a typed Prisma Client.
// Column names are snake_case to match the raw SQL; @map bridges that to
// camelCase in TypeScript. `role` and `status` are plain strings (not Prisma
// enums) on purpose — see supabase/README.md for why.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes a connection URL here — the CLI reads one from
// prisma.config.ts, and the running app supplies one via the driver adapter
// in src/lib/db.ts. This block just declares which SQL dialect to speak.
datasource db {
  provider = "postgresql"
}

// --- Identity -----------------------------------------------------------

/// Mirrors public.profiles. id is the same UUID as the matching row in
/// Supabase's own auth.users table. Rows are created automatically by a
/// database trigger (supabase/sql/004_new_user_trigger.sql) whenever someone
/// signs up — application code never inserts a Profile directly.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  /// "CUSTOMER" | "COMPANY" | "ADMIN" — enforced by a CHECK constraint in SQL,
  /// not a Postgres enum type, so it stays simple to read and change later.
  role      String   @default("CUSTOMER")
  /// True until the user finishes (or skips) the post-signup onboarding wizard.
  /// Always FALSE for existing users — see supabase migration 005.
  needsOnboarding Boolean @default(true) @map("needs_onboarding")
  /// JSON blob of profile answers (name, field, location for customers;
  /// company name, industry, size, location for companies).
  profileJson String? @map("profile_json")
  createdAt DateTime @default(now()) @map("created_at")

  resumes           Resume[]
  resumeAnalyses    ResumeAnalysis[]
  jobsPosted        Job[]              @relation("CompanyJobs")
  applications      Application[]      @relation("UserApplications")
  coverLetters      CoverLetter[]
  consent           Consent?
  sessionRecordings SessionRecording[]

  @@map("profiles")
}

// --- Resume builder -------------------------------------------------------

model Resume {
  id     String  @id @default(cuid())
  userId String  @db.Uuid @map("user_id")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
  coverLetters CoverLetter[]

  format String // matches an id in src/features/resume-builder/formats/*.ts
  title  String

  /// Raw wizard answers, keyed by field id — the source of truth for regenerating/exporting.
  fieldsJson String @map("fields_json")
  /// Rendered + user-edited HTML shown in the in-browser editor.
  htmlContent String @map("html_content")

  /// "DRAFT" | "FINAL"
  status    String   @default("DRAFT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("resumes")
}

// --- Resume analyzer (Groq) ------------------------------------------------

/// One row per "analyze my resume against this job" run. See
/// src/features/resume-analyzer/. Resume text is extracted from the
/// uploaded file in the browser (PDF/DOCX/TXT) and sent up as plain text —
/// the server never touches the original file.
model ResumeAnalysis {
  id     String  @id @default(cuid())
  userId String  @db.Uuid @map("user_id")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Original uploaded filename, kept for display only.
  fileName String? @map("file_name")

  jobTitle       String  @map("job_title")
  /// Optional pasted job description / requirements text.
  jobDescription String? @map("job_description")
  /// Extracted resume text sent to Groq — kept so a past analysis can be
  /// reviewed without re-uploading the file.
  resumeText     String  @map("resume_text")

  /// 0-100, pulled out of resultJson for cheap sorting/display in lists.
  matchScore Int? @map("match_score")
  /// Full structured analysis returned by Groq (see analysisResultSchema).
  resultJson String @map("result_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("resume_analyses")
}

// --- Job postings -----------------------------------------------------

/// A job/internship posting created by a COMPANY-role profile. See
/// src/features/jobs/. Visible to customers on /jobs while status is OPEN.
model Job {
  id        String  @id @default(cuid())
  companyId String  @db.Uuid @map("company_id")
  company   Profile @relation("CompanyJobs", fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  description String
  /// Optional qualifications/requirements text, separate from description.
  requirements String?

  /// "INTERNSHIP" | "PART_TIME" | "FULL_TIME"
  employmentType String @map("employment_type")
  hoursPerWeek   Int?   @map("hours_per_week")
  weeksPerYear   Int?   @map("weeks_per_year")
  /// Free text, e.g. "$20/hr", "$60,000-$70,000/yr", "Unpaid".
  pay            String?

  location     String?
  /// "REMOTE" | "ON_SITE" | "HYBRID"
  locationType String @map("location_type")

  /// "OPEN" | "CLOSED" — only OPEN postings show on the customer /jobs list.
  status String @default("OPEN")

  applications Application[]
  coverLetters CoverLetter[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

/// One customer's application to one Job, attaching an existing
/// resume-builder Resume. Unique per (jobId, userId) — one application
/// per person per posting.
model Application {
  id String @id @default(cuid())

  jobId String @map("job_id")
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId String  @db.Uuid @map("user_id")
  user   Profile @relation("UserApplications", fields: [userId], references: [id], onDelete: Cascade)

  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  /// Optional short message from the applicant.
  note String?

  /// "SUBMITTED" | "REVIEWED" | "SHORTLISTED" | "REJECTED"
  status String @default("SUBMITTED")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@map("applications")
}

// --- Cover letters (Groq) ---------------------------------------------

/// A generated cover letter, tied to one of the customer's own resumes
/// and either a job posted on this platform or a hand-described external
/// one. See src/features/cover-letters/.
model CoverLetter {
  id     String  @id @default(cuid())
  userId String  @db.Uuid @map("user_id")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  /// Set when generated for a job posted on this platform; null for a
  /// hand-described external job. onDelete: SetNull — deleting the
  /// platform job must not delete the customer's saved letter.
  jobId String? @map("job_id")
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Always populated — copied from the platform Job at generation time,
  /// or typed in directly for an external job. Independent of jobId so a
  /// saved letter keeps correct context even if the Job row changes later.
  companyName    String  @map("company_name")
  jobTitle       String  @map("job_title")
  jobDescription String? @map("job_description")

  /// Editable HTML content of the letter — same role as Resume.htmlContent.
  /// Always a flat sequence of <p> tags (see the generation prompt in
  /// Task 2) — no headers, no styling.
  htmlContent String @map("html_content")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("cover_letters")
}

// --- Session recording (admin) --------------------------------------------

model Consent {
  id                      String   @id @default(cuid())
  userId                  String   @unique @db.Uuid @map("user_id")
  user                    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionRecordingAllowed Boolean  @default(false) @map("session_recording_allowed")
  respondedAt             DateTime @default(now()) @map("responded_at")

  @@map("consent")
}

model SessionRecording {
  id     String  @id @default(cuid())
  userId String  @db.Uuid @map("user_id")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JSON-encoded array of batched rrweb events.
  events     String
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationMs Int?      @map("duration_ms")

  @@index([userId])
  @@map("session_recordings")
}
