# Copy this file to .env and fill in the values below.
# NEVER commit your .env file — it contains secrets.
# Where to find each value is explained in the README (Supabase Setup section).

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Supabase Dashboard → Project Settings → Database → Connection string
# Use the Transaction pooler URL (port 6543) — required for serverless/edge.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Groq (resume analyzer) ──────────────────────────────────────────────────
# console.groq.com → API Keys. Powers the resume-vs-job-description analysis
# feature. Leave unset and the rest of the app still runs fine.
GROQ_API_KEY="YOUR-GROQ-API-KEY"
# Optional — defaults to openai/gpt-oss-120b if not set.
# GROQ_MODEL="openai/gpt-oss-120b"
